							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\t\t\t\t\t\t\tReconciliation → when react interanally manages the states"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
